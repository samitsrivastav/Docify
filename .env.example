# Copy this file to .env and adjust as needed.

# Embedding model (Sentence-Transformers, downloaded from Hugging Face on first run)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM backend: "transformers" (default, no extra setup) or "ollama" (better quality,
# requires https://ollama.com installed + `ollama serve` running).
LLM_BACKEND=transformers

# Model name for the chosen backend.
#   transformers: google/flan-t5-base (default), google/flan-t5-small (faster/lighter), etc.
#   ollama:       llama3.2 (default), phi3, mistral, etc. Must be pulled first: `ollama pull <name>`
LLM_MODEL=google/flan-t5-base

# Only used when LLM_BACKEND=ollama
OLLAMA_HOST=http://localhost:11434

# Chunking
CHUNK_SIZE=220
CHUNK_OVERLAP=40

# Retrieval
TOP_K=5

LOG_LEVEL=INFO
